# FemFinHub Production & Development Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# WhatsApp Cloud API Integration
WHATSAPP_BUSINESS_NUMBER=+14155238886
WHATSAPP_VERIFY_TOKEN=femfinhub_secure_token
WHATSAPP_CLOUD_API_TOKEN=EAAG...meta_cloud_api_bearer_token

# Polygon / Ethereum Web3 RPC Provider
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
SMART_CONTRACT_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F

# Database Configuration (MongoDB / Supabase / PostgreSQL)
DATABASE_URL=postgresql://femfin_admin:password@localhost:5432/femfinhub_db
